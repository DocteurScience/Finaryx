msgstr[0] "{n} банк"
msgstr[1] "{n} банки"
msgstr[2] "{n} банків"

msgid "{n} virement entre vos comptes à confirmer"
msgid_plural "{n} virements entre vos comptes à confirmer"
msgstr[0] "{n} переказ між вашими рахунками чекає підтвердження"
msgstr[1] "{n} перекази між вашими рахунками чекають підтвердження"
msgstr[2] "{n} переказів між вашими рахунками чекають підтвердження"

msgid "Voir"
msgstr "Переглянути"

msgid "La copie de sauvegarde automatique a échoué : {error}"
msgstr "Не вдалося створити автоматичну резервну копію: {error}"

msgid "La base de données n’est pas ouverte."
msgstr "Базу даних не відкрито."

msgid "La modification n’a pas pu être enregistrée : {error}"
msgstr "Не вдалося зберегти зміну: {error}"

msgid "Compte ajouté"
msgstr "Рахунок додано"

msgid "Compte archivé"
msgstr "Рахунок архівовано"

msgid "Compte désarchivé"
msgstr "Рахунок розархівовано"

msgid "Le compte, son historique d’import et {n} opération seront effacés définitivement."
msgid_plural "Le compte, son historique d’import et ses {n} opérations seront effacés définitivement."
msgstr[0] "Рахунок, його історію імпорту та {n} операцію буде остаточно стерто."
msgstr[1] "Рахунок, його історію імпорту та {n} операції буде остаточно стерто."
msgstr[2] "Рахунок, його історію імпорту та {n} операцій буде остаточно стерто."

msgid "Compte supprimé, {n} opération effacée"
