msgstr[0] "Рахунок видалено, стерто {n} операцію"
msgstr[1] "Рахунок видалено, стерто {n} операції"
msgstr[2] "Рахунок видалено, стерто {n} операцій"

msgid "sans nom"
msgstr "без назви"

msgid "Annuler cet import ?"
msgstr "Скасувати цей імпорт?"

msgid "{n} opération ajoutée par « {file} » sur {account} sera supprimée. Les autres imports ne sont pas modifiés."
msgid_plural "Les {n} opérations ajoutées par « {file} » sur {account} seront supprimées. Les autres imports ne sont pas modifiés."
msgstr[0] "{n} операцію, додану файлом «{file}» до {account}, буде видалено. Інші імпорти не зміняться."
msgstr[1] "{n} операції, додані файлом «{file}» до {account}, буде видалено. Інші імпорти не зміняться."
msgstr[2] "{n} операцій, доданих файлом «{file}» до {account}, буде видалено. Інші імпорти не зміняться."

