msgstr[1] "Прогноз потребує щонайменше 3 місяці операцій. Бракує {n} місяців."
msgstr[2] "Прогноз потребує щонайменше 3 місяці операцій. Бракує {n} місяців."

msgid "Prévision à 6 mois"
msgstr "Прогноз на 6 місяців"

msgid "Pas encore d’opérations"
msgstr "Операцій поки немає"

msgid "Importez l’export CSV d’un compte pour voir cette vue."
msgstr "Імпортуйте CSV-експорт рахунку, щоб побачити цей вигляд."

msgid "Votre nom, celui de votre conjoint… Un virement dont le libellé contient l’un de ces noms est proposé comme virement interne : ni dépense, ni revenu."
msgstr "Ваше ім’я, ім’я партнера… Переказ, опис якого містить одне з цих імен, пропонується як внутрішній переказ: ні витрата, ні дохід."

msgid "Retirer ce nom"
msgstr "Прибрати це ім’я"

msgid "Ajouter un nom"
msgstr "Додати ім’я"

msgid "Suivre le système"
msgstr "Як у системі"

msgid "Clair"
msgstr "Світлий"

msgid "Sombre"
msgstr "Темний"

msgid "Apparence"
msgstr "Вигляд"

msgid "Confidentialité"
msgstr "Приватність"

msgid "Toutes vos données restent sur cet ordinateur. Finaryx n’effectue aucune requête réseau. La base de données n’est pas chiffrée."
msgstr "Усі ваші дані залишаються на цьому комп’ютері. Finaryx не робить мережевих запитів. База даних не зашифрована."

msgid "Impossible de lire la base de données."
msgstr "Не вдалося прочитати базу даних."

