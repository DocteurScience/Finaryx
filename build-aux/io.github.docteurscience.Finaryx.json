{
  "id": "io.github.docteurscience.Finaryx",
  "runtime": "org.gnome.Platform",
  "runtime-version": "49",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "finaryx",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/finaryx/cargo",
      "CARGO_NET_OFFLINE": "true",
      "RUST_BACKTRACE": "1"
    }
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/doc",
    "*.la",
    "*.a"
  ],
  "modules": [
    {
      "name": "finaryx",
      "buildsystem": "meson",
      "run-tests": true,
      "config-opts": [
        "-Dprofile=default"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/DocteurScience/Finaryx.git",
          "tag": "v0.1.0"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
